{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netcomposer.art/schema/hack-chain.json",
  "title": "NetComposer hack chain",
  "description": "The Live hack stack. Schema 2 is one flat chain, limiter last: that is what Save posts today, and it is the master chain. Schema 3 adds a master chain, empty track chains for up to eight tracks, and an optional whole-piece glide. The page checks this with create/hacks/validate.js. The server stores schema 3 and does not run it.",
  "oneOf": [
    { "$ref": "#/$defs/schema2" },
    { "$ref": "#/$defs/schema3" }
  ],
  "$defs": {
    "hack": {
      "type": "object",
      "required": ["id", "type", "version", "bypass", "params"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": {
          "type": "string",
          "enum": ["lowpass", "highpass", "bandpass", "delay", "plate", "eq", "drive", "compressor", "width", "limiter"]
        },
        "version": { "type": "integer" },
        "bypass": { "type": "boolean" },
        "fixed": { "type": "boolean" },
        "params": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "null"] },
          "description": "Flat dial values. Null is an open filter. No nested objects."
        },
        "auto": { "$ref": "#/$defs/glide" }
      }
    },
    "glide": {
      "type": "object",
      "required": ["param", "from", "to", "over"],
      "description": "A filter frequency moving across the whole piece in log Hz. Other hacks do not glide. Schema 3 only.",
      "properties": {
        "param": { "enum": ["cutoff_hz", "centre_hz"] },
        "from": { "type": "number", "exclusiveMinimum": 0 },
        "to": { "type": "number", "exclusiveMinimum": 0 },
        "over": { "const": "piece" }
      }
    },
    "masterChain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "description": "At most 10 movable hacks, then the fixed limiter.",
      "items": { "$ref": "#/$defs/hack" }
    },
    "trackChain": {
      "type": "object",
      "required": ["chain"],
      "properties": {
        "chain": {
          "type": "array",
          "maxItems": 10,
          "description": "Movable hacks only. Empty is dry: no 0.8, no limiter.",
          "items": { "$ref": "#/$defs/hack" }
        }
      }
    },
    "schema2": {
      "type": "object",
      "required": ["schema", "chain"],
      "properties": {
        "schema": { "const": 2 },
        "chain": { "$ref": "#/$defs/masterChain" }
      }
    },
    "schema3": {
      "type": "object",
      "required": ["schema", "master"],
      "properties": {
        "schema": { "const": 3 },
        "master": {
          "type": "object",
          "required": ["chain"],
          "properties": { "chain": { "$ref": "#/$defs/masterChain" } }
        },
        "tracks": {
          "type": "object",
          "maxProperties": 8,
          "description": "Keys t1 through t8 only. Any other track uses the master chain and is not stored here.",
          "additionalProperties": false,
          "properties": {
            "t1": { "$ref": "#/$defs/trackChain" },
            "t2": { "$ref": "#/$defs/trackChain" },
            "t3": { "$ref": "#/$defs/trackChain" },
            "t4": { "$ref": "#/$defs/trackChain" },
            "t5": { "$ref": "#/$defs/trackChain" },
            "t6": { "$ref": "#/$defs/trackChain" },
            "t7": { "$ref": "#/$defs/trackChain" },
            "t8": { "$ref": "#/$defs/trackChain" }
          }
        }
      }
    }
  }
}
